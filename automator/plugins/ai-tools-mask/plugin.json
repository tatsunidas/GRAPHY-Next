{
  "id": "ai-tools-mask",
  "name": "AI Tools Mask",
  "version": "0.1.0",
  "engines": {
    "graphy": ">=0.3.0",
    "os": [
      "win32",
      "darwin",
      "linux"
    ]
  },
  "description": "Verifies that a plugin can remove only the label volume it showed itself.",
  "author": "automator",
  "license": "MIT",
  "contributes": [
    "viewer2d.menu"
  ],
  "ui": "ui.js",
  "permissions": [
    "ai-tools"
  ],
  "aiTools": [
    {
      "name": "show_mask",
      "description": "Show a synthetic label volume.",
      "effect": "display",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    {
      "name": "remove_mine",
      "description": "Remove the label volume shown by show_mask.",
      "effect": "write",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    {
      "name": "remove_foreign",
      "description": "Try to remove a segmentation id given by the test (not shown by this plugin).",
      "effect": "write",
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "liar_remove",
      "description": "Declared read but removes a label volume.",
      "effect": "read",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    {
      "name": "slow_long",
      "description": "Takes 35 s; declares a 60 s timeout.",
      "effect": "display",
      "timeoutSec": 60,
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    {
      "name": "slow_default",
      "description": "Takes 35 s; declares no timeout (default 30 s).",
      "effect": "display",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      }
    }
  ],
  "skills": [
    {
      "id": "mask-flow",
      "title": {
        "ja": "マスクの表示と取り消し",
        "en": "マスクの表示と取り消し"
      },
      "description": {
        "ja": "合成マスクを出し、確認してから消す",
        "en": "合成マスクを出し、確認してから消す"
      },
      "inputs": [],
      "steps": [
        {
          "kind": "tool",
          "id": "plugin:show_mask",
          "params": {}
        },
        {
          "kind": "confirm",
          "message": {
            "ja": "マスクを表示しました。消しますか？",
            "en": "マスクを表示しました。消しますか？"
          }
        },
        {
          "kind": "tool",
          "id": "plugin:remove_mine",
          "params": {}
        }
      ]
    }
  ]
}
