{
  "name": "graphy-next-desktop",
  "version": "0.5.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "GRAPHY-Next desktop (Electron) — standalone mode",
  "author": { "name": "Visionary Imaging Services", "email": "customerservices@vis-ionary.com" },
  "homepage": "https://github.com/tatsunidas/GRAPHY-Next",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.7.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.vis.graphynext",
    "productName": "GRAPHY-Next",
    "afterPack": "scripts/afterPack.js",
    "files": ["main.js", "preload.js", "windowState.js", "windowGeometry.js", "splash.html", "splash-preload.js", "startupMessages.js", "secretStore.js", "aiGateway.js", "aiHttp.js", "aiProviders.js", "assistantSender.js", "computeEndpoints.js", "localPython.js", "localJupyter.js", "dbFolders.js", "devDataDir.js", "renderPrefs.js", "gpuMemory.js", "tlsPasswords.js", "portWait.js", "computeBridge.js", "computeConsent.js", "computeConsent-preload.js", "computeConsent.html", "computeConsent-view.js", "computeConsent-rows.js", "computeKeepAwake.js", "colabAuth.js", "colabApi.js", "colabRuntimes.js", "computeDefault.js", "colab-oauth-client.json", "gdriveAuth.js", "gdriveFolder.js", "gdriveMode.js", "gdrivePicker.js", "gdrive-oauth-client.json", "aiAdapters/*.js", "!**/*.test.js", "config.json", "renderer/**"],
    "extraResources": [
      { "from": "resources/backend", "to": "backend" },
      { "from": "resources/jre", "to": "jre" },
      { "from": "resources/ffmpeg", "to": "ffmpeg" },
      { "from": "resources/dcm4che", "to": "dcm4che" },
      { "from": "resources/bundled-plugins", "to": "bundled-plugins" },
      { "from": "uninstall", "to": "uninstall" }
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Graphics;MedicalSoftware",
      "extraResources": [{ "from": "build/linux/apparmor-profile", "to": "apparmor-profile" }]
    },
    "deb": { "afterInstall": "build/linux/after-install.sh", "afterRemove": "build/linux/after-remove.sh" },
    "win": { "target": ["nsis"] },
    "mac": { "target": ["dmg"], "identity": null, "artifactName": "${productName}-${version}-${arch}.${ext}" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    }
  }
}
